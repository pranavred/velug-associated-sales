# Company workspace. Copy to .env and keep it private.
PUBLIC_ORIGIN=http://127.0.0.1:4319
BASE_PATH=/associated-sales
PORT=4319
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-2025-04-14
MAX_MODEL_CALLS_PER_DAY=20
INVENTORY_MAX_AGE_DAYS=30
MAX_CATALOG_CANDIDATES=80

# Initial owner only. Set before first start, then remove the password.
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=
BOOTSTRAP_COMPANY=

# Native Node only; Docker supplies its persistent-volume path.
# DATABASE_PATH=data/platform.sqlite

# Optional legacy localhost demo; not used by the company workspace.
# Run with PORT=4317 npm run dashboard
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6
# DISCOVERY_HOURS=168
# SYNTHESIS_HOURS=24
# MAX_MODEL_CALLS=5
