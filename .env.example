# Copy to .env; the CLI loads it automatically. Existing environment variables take precedence.
# Defaults: weekly discovery, daily synthesis check, per-source weekly/monthly fetch.
DISCOVERY_HOURS=168
SYNTHESIS_HOURS=24
MAX_MODEL_CALLS=5
PORT=4317
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Persistent cap across worker restarts; counts attempts, not dollars.
MAX_MODEL_CALLS_PER_DAY=20
